+/* 便携版改动: SASL 插件目录指向 <包根>/bin/../lib/sasl2 (由 /proc/self/exe
+ * 推导)。动态链接 cyrus-sasl 时 PLAIN 等机制插件随包分发, 用此回调让库
+ * 从包内目录加载, 解压即用、无需设置 SASL_PATH。定位失败返回 SASL_FAIL,
+ * cyrus-sasl 回退到默认插件路径。 */
+static char sasl_plugin_dir[PATH_MAX];
+static int sasl_getpluginpath(void *context, const char **path)
+{
+    (void)context;
+    ssize_t len = readlink("/proc/self/exe", sasl_plugin_dir,
+                           sizeof(sasl_plugin_dir) - 1);
+    if (len <= 0) {
+        return SASL_FAIL;
+    }
+    sasl_plugin_dir[len] = '\0';
+    char *slash = strrchr(sasl_plugin_dir, '/');
+    if (slash == NULL) {
+        return SASL_FAIL;
+    }
+    *slash = '\0';
+    if (strlen(sasl_plugin_dir) + sizeof("/../lib/sasl2") > sizeof(sasl_plugin_dir)) {
+        return SASL_FAIL;
+    }
+    strcat(sasl_plugin_dir, "/../lib/sasl2");
+    *path = sasl_plugin_dir;
+    return SASL_OK;
+}
